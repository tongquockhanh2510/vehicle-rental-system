CONFIG_SERVICE_PORT=3000

# MongoDB
MONGODB_URI=mongodb://admin:password@mongodb-vehicle-rental:27017/redis_vehicle_db?authSource=admin

# RabbitMQ
RABBITMQ_URI=amqp://admin:password@rabbitmq-vehicle-rental:5672

# Redis
REDIS_HOST=redis-vehicle-rental
REDIS_PORT=6379

# JWT
JWT_SECRET=your-super-secret-key-change-in-production
JWT_EXPIRES_IN=24h

# Environment
NODE_ENV=development
